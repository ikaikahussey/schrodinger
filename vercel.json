{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": { "api/index.js": { "maxDuration": 300, "memory": 1024, "includeFiles": "server/views/**" } },
  "rewrites": [ { "source": "/(.*)", "destination": "/api/index" } ],
  "crons": [ { "path": "/api/harness/cron", "schedule": "0 17 * * *" } ]
}
