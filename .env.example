# Optional. Without it the harness runs a deterministic mock LLM.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
PORT=3000
HARNESS_INTERVAL_MS=300000
STALE_DAYS=5
MAX_TASKS_PER_RUN=3
AGENT_MAX_TURNS=12
# Postgres connection string. Unset = embedded PGlite (set PGLITE_DIR to persist it on disk).
DATABASE_URL=
PGLITE_DIR=./data/pglite
# Vercel Cron auth (set the same value in Vercel env)
CRON_SECRET=
# Required before exposing to the internet. Login page appears when set.
APP_PASSWORD=
# Optional: separate cookie-signing secret (defaults to APP_PASSWORD)
APP_SECRET=
